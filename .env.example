# Google Gemini API Configuration for FluentAI
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Name (e.g. gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro)
EXPO_PUBLIC_GEMINI_MODEL=gemini-1.5-flash

# Optional: Default App Language / Voice locale (default: en-US)
EXPO_PUBLIC_VOICE_LOCALE=en-US
